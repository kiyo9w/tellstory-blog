rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'buitonggiang0805@gmail.com';
    }

    match /anonymous_messages/{messageId} {
      allow create: if request.resource.data.message is string
        && request.resource.data.message.size() >= 2
        && request.resource.data.message.size() <= 5000;
      allow read, update, delete: if isAdmin();
    }

    match /article_comments/{commentId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 2
        && request.resource.data.message.size() <= 2000;
      allow update, delete: if isAdmin();
    }

    match /irregular_v11_students/{learnerId} {
      allow read, write: if request.auth != null;

      match /events/{eventId} {
        allow read, write: if request.auth != null;
      }
    }

    match /irregular_v11_snapshots/{snapshotId} {
      allow read, write: if request.auth != null;
    }
  }
}
